# 可复制为根目录 .env；当前电脑已有配置时无需复制。
# 页面保存的模型、并发与密钥设置优先于这里。
# 密钥可继续放在根目录 deepseek 文件，不必重复保存。
# DEEPSEEK_API_KEY=填写自己的密钥
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CONCURRENCY=4
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_CALLS=48
# 私有目录需使用 WSL/Linux 路径；恢复备份后可切换。
# FEEDBACK_DATA_DIR=/home/algor/feedback-restored
# 端口通过 ./feedback.sh start --port 设置，不从 .env 读取。
